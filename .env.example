# Database (libSQL / SQLite). Local file for development:
DATABASE_URL="file:./dev.db"
# Only needed for a hosted libSQL/Turso database
DATABASE_AUTH_TOKEN=

# Auth
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET=            # generate with: npx auth secret

# Encrypts entries in the shared password vault. Generate your own and keep it safe:
# losing it makes stored entries unreadable. 64 hex chars: openssl rand -hex 32
ENCRYPTION_KEY=

# Seeding. There are no default credentials: the admin account is only
# created when both ADMIN_ values are set.
ADMIN_EMAIL=
ADMIN_PASSWORD=
SEED_SECRET=            # required to call /api/admin/seed

# Optional: email notifications and password-reset mail
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NEXT_PUBLIC_EMAIL_CONFIGURED=false

# Optional: location autocomplete on calendar events
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
